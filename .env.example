# Copy to .env to override defaults. Optional: every knob has one.
# Per-run choices are CLI flags, see `crawl run --help`.

# ---- LLM ----
# litellm format: provider/model-name. Empty = openai/gpt-4o-mini.
# Without a key and without LLM_BASE_URL the LLM stages are skipped.
LLM_MODEL=
LLM_API_KEY=
# Custom endpoint for self-hosted or proxied LLMs.
LLM_BASE_URL=
# Max concurrent LLM calls. Keep low to avoid rate limits.
LLM_CONCURRENCY=2
# Ceiling on one reply, thinking included. Raise it if the log shows
# llm.chat.output_ceiling.
LLM_MAX_OUTPUT_TOKENS=16384
# How much candidate text one ranking call may carry. A batch over this
# is split into more calls rather than cut.
LLM_MAX_BATCH_CHARS=12000
# How hard the model thinks before answering, per stage.
# Ranker, Analyzer and seeds/goals Enhancer, respectively.
# off | low | medium | high. Empty takes the provider's default.
# Translated to whatever the model in use accepts.
LLM_RANK_REASONING_EFFORT=off
LLM_ANALYZE_REASONING_EFFORT=medium
LLM_ENHANCE_REASONING_EFFORT=medium

# ---- Fetch ----
# Parallel page downloads.
FETCH_CONCURRENCY=6
# TCP/TLS handshake timeout, seconds.
FETCH_TIMEOUT_CONNECT=10.0
# First-byte-of-response timeout, seconds.
FETCH_TIMEOUT_READ=30.0
# Retries on transient errors (5xx, timeout, DNS).
FETCH_MAX_RETRIES=3
# Browser fetches only: ceiling on the responses one page load keeps.
# Held in memory before reaching disk.
BROWSER_MAX_PAYLOAD_BYTES=8388608
# Feed listings only: how many times to scroll for more posts.
FEED_SCROLLS=4
# Bounds on how many seeds --enhance-seeds may add:
# clamp(4 + 2*log2(seeds you gave), MIN, MAX).
ENHANCE_SEEDS_MIN=4
ENHANCE_SEEDS_MAX=12

# ---- Extract ----
# Safety valve for pathological HTML, seconds.
EXTRACT_TIMEOUT=120.0

# ---- Frontier ----
# Buffer capacity before low-quality eviction kicks in.
CANDIDATE_BUFFER_SIZE=2000

# ---- Logging ----
# DEBUG | INFO | OFF. The --log-level flag overrides this.
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
