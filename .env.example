# Copy to .env to override defaults. Every knob has a default, so this
# file is optional — `crawl run` works out of the box without it.
# Per-run choices (budgets, robots, embedding provider, log verbosity)
# are CLI flags: see `crawl run --help`.

# ---- LLM (v0.2+) ----
# litellm format: provider/model-name
LLM_MODEL=openai/gpt-4o-mini
# Secret: env only, never a flag.
LLM_API_KEY=
# Custom endpoint for self-hosted / proxied LLMs. Empty = provider default.
LLM_BASE_URL=
# Max concurrent LLM calls. Keep low to avoid rate limits.
LLM_CONCURRENCY=2

# ---- Embedding (provider chosen per run: --embedding local|api, default local) ----
# Secret: env only, never a flag. Only needed for --embedding api.
EMBEDDING_API_KEY=
# Endpoint base URL. Empty = OpenAI default. Point at Jina/Ollama/etc.
EMBEDDING_BASE_URL=
# Top-K candidates the embedding stage keeps per rank batch.
EMBEDDING_KEEP=60

# ---- Fetch ----
# Parallel page downloads.
FETCH_CONCURRENCY=6
# TCP/TLS handshake timeout, seconds.
FETCH_TIMEOUT_CONNECT=10.0
# First-byte-of-response timeout, seconds.
FETCH_TIMEOUT_READ=30.0
# Retries on transient errors (5xx, timeout, DNS).
FETCH_MAX_RETRIES=3
# User-Agent rotation pool (JSON list).
# USER_AGENTS=["crawl-me-maybe/0.1"]

# ---- Extract ----
# Safety valve for pathological HTML, seconds.
EXTRACT_TIMEOUT=120.0

# ---- Frontier ----
# Buffer capacity before low-quality eviction kicks in.
CANDIDATE_BUFFER_SIZE=2000
# Candidates scored per rank batch.
RANK_BATCH_SIZE=100
# Min interval between rank cycles, seconds.
RANK_COOLDOWN_SEC=30.0
# Snapshot every N fetched pages.
CHECKPOINT_INTERVAL=10
# Aging window so old low-priority items don't starve, seconds.
PRIORITY_AGING_WINDOW=600.0

# ---- Robots ----
# robots.txt cache lifetime, hours.
ROBOTS_TTL_HOURS=24
# Consecutive 429/503 responses before a domain is circuit-broken.
CIRCUIT_BREAKER_THRESHOLD=5
# Circuit-breaker cooldown, minutes.
CIRCUIT_BREAKER_COOLDOWN_MIN=10

# ---- Logging ----
# Dual knob: the --log-level flag overrides this default.
# DEBUG | INFO | WARNING | ERROR | CRITICAL | OFF
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json
