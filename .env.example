# Copy to .env to override defaults. Every knob has a default, so this
# file is optional. `crawl run` works out of the box without it.
# Per-run choices (budgets, robots, embedding provider, log verbosity)
# are CLI flags: see `crawl run --help`.

# ---- LLM ----
# LLM is ON by default. Set LLM_API_KEY alone and you get
# openai/gpt-4o-mini. Without LLM_API_KEY and without a custom
# LLM_BASE_URL the LLM stages are skipped automatically and the
# crawl runs on rule + embedding alone.
# litellm format: provider/model-name. Empty = openai/gpt-4o-mini.
LLM_MODEL=
LLM_API_KEY=
# Custom endpoint for self-hosted / proxied LLMs. Also what enables
# keyless local endpoints.
LLM_BASE_URL=
# Max concurrent LLM calls. Keep low to avoid rate limits.
LLM_CONCURRENCY=2
# Ceiling on one reply. A reasoning model spends this on thinking before
# it writes any answer, so too low a value returns an empty or half
# finished reply that looks like a parsing failure. Only tokens actually
# generated are billed, so raising it costs nothing until it is used.
# Raise this if the log shows llm.chat.output_ceiling.
LLM_MAX_OUTPUT_TOKENS=8192
# How much candidate text one ranking call may carry. Candidates are
# never cut to fit: a batch over this is split into more calls, because
# a post whose only relevant line sits past a cut gets rejected for not
# containing what was cut off. Raise it for a wider context window.
LLM_MAX_BATCH_CHARS=12000
# How hard the model thinks before answering, per stage, on models that
# think. Empty takes the provider's default. Values: minimal, low,
# medium, high; on DeepSeek "none" is the only one that turns it off.
LLM_RANK_REASONING_EFFORT=none
LLM_ANALYZE_REASONING_EFFORT=medium
# Both enhancers ask for a short list of URLs. One run spent all 8191
# output tokens thinking and returned an empty answer, so this is off.
LLM_ENHANCE_REASONING_EFFORT=none

# ---- Fetch ----
# Parallel page downloads.
FETCH_CONCURRENCY=6
# TCP/TLS handshake timeout, seconds.
FETCH_TIMEOUT_CONNECT=10.0
# First-byte-of-response timeout, seconds.
FETCH_TIMEOUT_READ=30.0
# Retries on transient errors (5xx, timeout, DNS).
FETCH_MAX_RETRIES=3
# Browser fetches only: ceiling on what one page load keeps of the
# responses it made for itself. Held in memory before reaching disk, so
# lower it on a machine that is tight on RAM.
BROWSER_MAX_PAYLOAD_BYTES=8388608
# Feed listings only: how many times to ask a listing for more posts. A
# listing hands out one screen, so a window of weeks is otherwise
# answered with the dozen most recent. Each scroll is one more request
# the page makes, so raising it trades coverage for exposure.
FEED_SCROLLS=4
# How many seeds --enhance-seeds may add, from how many you gave:
# clamp(4 + 2*log2(yours), MIN, MAX). Bounds rather than a count, since
# one seed still deserves a few and thirty does not need thirty more.
# Each costs a fetch to verify, which is what caps the top.
ENHANCE_SEEDS_MIN=4
ENHANCE_SEEDS_MAX=12

# ---- Extract ----
# Safety valve for pathological HTML, seconds.
EXTRACT_TIMEOUT=120.0

# ---- Frontier ----
# Buffer capacity before low-quality eviction kicks in.
CANDIDATE_BUFFER_SIZE=2000

# ---- Logging ----
# Dual knob: the --log-level flag overrides this default.
# DEBUG | INFO | OFF
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=console
